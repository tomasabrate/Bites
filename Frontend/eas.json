{
  "cli": {
    "version": ">= 3.16.0"
  },
  "build": {
    "preview": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_MODULES_AUTO_LINKING": "1",
        "EXPO_NO_BUNDLER": "1"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "EXPO_MODULES_AUTO_LINKING": "1",
        "EXPO_NO_BUNDLER": "1"
      }
    }
  }
}
